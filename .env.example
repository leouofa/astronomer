# Database password override for Docker Compose
POSTGRES_PASSWORD=astronomer

# Ollama / LLM endpoint (use http://host.docker.internal:11434/v1 in Docker Compose)
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=Qwen3.6-35B-A3B-NVFP4

# Embedding endpoint and model. Embeddings may run on a different Ollama instance
# than chat. Uncomment and set to http://localhost:11434/v1 when running `bin/dev`
# on the host, or http://host.docker.internal:11434/v1 inside Docker Compose.
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:0.6b

# Redis URL for Sidekiq (defaults to redis://redis:6379/0 in Docker Compose)
REDIS_URL=redis://localhost:6379/0

# Additional allowed hostnames for Rails Host Authorization (comma-separated)
# RAILS_DEVELOPMENT_HOSTS=astronomer.your-domain.com
