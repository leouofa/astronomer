<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "star_systems/modal", star_system: @star_system %>
<% else %>
  <% content_for :title, "#{@star_system.name} | Star Systems | Astronomer" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@star_system) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Star Systems", star_systems_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <%= link_to "Browse Celestial Bodies →", celestial_bodies_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600"><%= @star_system.cosmic_structure.name %></p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900"><%= @star_system.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @star_system.description %></p>

      <% if @star_system.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Themes for <%= @star_system.name %>">
          <% @star_system.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "star_systems/celestial_bodies_section", star_system: @star_system %>

    <%= render "shared/embedding_panel",
               record: @star_system,
               action_path: generate_embedding_star_system_path(@star_system),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
