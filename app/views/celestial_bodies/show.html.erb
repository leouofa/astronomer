<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "celestial_bodies/modal", celestial_body: @celestial_body %>
<% else %>
  <% content_for :title, "#{@celestial_body.name} | Planets & Celestial Bodies | Astronomer" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@celestial_body) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Celestial Bodies", celestial_bodies_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <%= link_to "View Star System (#{@celestial_body.star_system.name}) →", star_system_path(@celestial_body.star_system), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
          <%= @celestial_body.star_system.cosmic_structure.name %>
        </span>
        <span class="text-xs text-slate-500">&bull;</span>
        <span class="text-xs font-medium text-slate-600"><%= @celestial_body.star_system.name %></span>
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><%= @celestial_body.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @celestial_body.description %></p>

      <% if @celestial_body.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Thematic tags for <%= @celestial_body.name %>">
          <% @celestial_body.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "shared/embedding_panel",
               record: @celestial_body,
               action_path: generate_embedding_celestial_body_path(@celestial_body),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
