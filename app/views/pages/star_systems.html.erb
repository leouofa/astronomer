<% content_for :title, "Star Systems | Astronomer" %>

<%= turbo_stream_from PopulateStarSystemsJob::GLOBAL_STREAM_NAME %>

<div class="w-full max-w-5xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Star Systems</h1>
      <p class="mt-2 text-sm text-slate-600">
        <%= @total_star_systems_count %> star systems cataloged across <%= @cosmic_structures_count %> galaxies / clusters.
      </p>
    </div>

    <div class="shrink-0">
      <%= render "pages/populate_controls",
                 running: false,
                 action_path: populate_star_systems_path,
                 button_label: "Discover Star Systems",
                 controls_target: "populate_all_star_systems_controls",
                 status_message: notice,
                 status_kind: (notice.present? ? :info : nil) %>
    </div>
  </header>

  <%= render "pages/star_systems_list",
             cosmic_structure_groups: @cosmic_structure_groups,
             total_star_systems_count: @total_star_systems_count,
             cosmic_structures_count: @cosmic_structures_count %>
</div>
